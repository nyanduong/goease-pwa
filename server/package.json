{
  "name": "@goease/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:init": "tsx scripts/db-init.ts"
  },
  "dependencies": {
    "@goease/contracts": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "mongoose": "9.11.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6"
  }
}
