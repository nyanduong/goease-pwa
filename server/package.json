{
  "name": "@goease/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:access": "tsx scripts/admin-access.ts",
    "geoapify:sample": "tsx scripts/geoapify-sample.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:init": "tsx scripts/db-init.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/*.integration.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "media:upload": "tsx scripts/cloudinary-media.ts upload",
    "media:verify": "tsx scripts/cloudinary-media.ts verify"
  },
  "dependencies": {
    "@goease/contracts": "*",
    "@goease/media": "*",
    "@node-rs/argon2": "2.2.2",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "jose": "6.2.13",
    "mongoose": "9.11.3",
    "nodemailer": "10.2.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2"
  }
}
