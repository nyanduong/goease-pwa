NODE_ENV=development
HOST=localhost
PORT=3000
CLIENT_ORIGIN=http://localhost:5180
MONGODB_URI=mongodb://127.0.0.1:27019/goease?replicaSet=rs0
# Only the dedicated loopback database below is accepted by db:check.
MONGODB_TEST_URI=mongodb://127.0.0.1:27019/goease_f0_test?replicaSet=rs0

# Local email uses a development-only filesystem mailbox; no real mail adapter yet.
SESSION_TTL_SECONDS=604800
SESSION_IDLE_SECONDS=86400
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=900
# Optional Google OIDC. Leave empty until credentials are configured on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PKCE_KEY=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
