NODE_ENV=development
HOST=localhost
PORT=3000
CLIENT_ORIGIN=http://localhost:5180
MONGODB_URI=mongodb://localhost:27017/goease?replicaSet=rs0
# Only the dedicated loopback database below is accepted by db:check.
MONGODB_TEST_URI=mongodb://localhost:27017/goease_f0_test?replicaSet=rs0

# Session authentication does not depend on email delivery.
SESSION_TTL_SECONDS=604800
SESSION_IDLE_SECONDS=86400
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=900
# Optional Google OIDC. Leave empty until credentials are configured on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PKCE_KEY=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Server only. Never use VITE_ variables for this key.
GEMINI_API_KEY=
# Server-only Places API; optional until configured. Never expose as VITE_*.
GEOAPIFY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local development guardrails, not a paid entitlement or provider billing cap.
# Daily window resets at 00:00 UTC. Unknown provider outcomes remain counted.
AI_DAILY_USER_LIMIT=5
AI_DAILY_GLOBAL_LIMIT=20

# Real password recovery email. Server-only credentials; leave blank until configured.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address,
# SMTP_PASS=Google app password (not your normal account password), MAIL_FROM=same address.
# Port465 uses TLS; other ports require STARTTLS with valid certificates.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESET_TOKEN_TTL_SECONDS=900

# Set true after SMTP is configured. No direct-registration fallback in OTP mode.
REGISTRATION_OTP_REQUIRED=false

# Choose gemini (Google direct) or fulldichvu. No automatic paid fallback.
AI_PROVIDER=gemini
# FULLDICHVU endpoint is fixed server-side; never put this key in VITE_*.
FULLDICHVU_API_KEY=
FULLDICHVU_MODEL=fulldichvu/haiku-4.5

# Server-side repository media and authenticated customer avatar uploads.
# Use an existing Cloudinary key; never put these credentials in VITE_* or Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bounded photo jobs; Commons search requests remain serialized in each API process.
PHOTO_WORKER_CONCURRENCY=3
DESCRIPTION_WORKER_CONCURRENCY=3
VISIT_WORKER_CONCURRENCY=4
# Optional 2-digit province code to process first, e.g. 48 for Da Nang.
# Leave this line commented for nationwide queue order.
# PHOTO_PRIORITY_PROVINCE_CODE=48
