# Copy outside the release to /etc/goease/server.env, readable only by root.
# Supply the real URI on the VPS; do not commit it or paste it into logs.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_LOOPBACK=true
BACKGROUND_WORKERS_ENABLED=false
CLIENT_ORIGIN=https://test.example.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/goease_test?retryWrites=true&w=majority
GOOGLE_REDIRECT_URI=https://test.example.com/api/v1/auth/google/callback

# When explicitly enabled, start with one worker per source on a 1-GB machine.
PHOTO_WORKER_CONCURRENCY=1
DESCRIPTION_WORKER_CONCURRENCY=1
VISIT_WORKER_CONCURRENCY=1
DESCRIPTION_TRANSLATION_ENABLED=false

# Add only the provider/SMTP/session settings needed from server/.env.example.
# Do not copy provider secrets automatically from a local environment.
